{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared asset evidence / 1",
  "type": "object",
  "required": [
    "schema_version",
    "identity",
    "assembly_owner",
    "evidence_status",
    "sources",
    "axes",
    "publication",
    "cadence",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "shared-asset-evidence/1"
    },
    "identity": {
      "type": "object",
      "required": [
        "project",
        "component",
        "chain",
        "token",
        "decimals"
      ],
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "assembly_owner": {
      "const": "BackingMonitor"
    },
    "evidence_status": {
      "type": "string"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "owner",
          "status"
        ]
      }
    },
    "axes": {
      "type": "object",
      "required": [
        "stability",
        "backing",
        "liquidity_exit",
        "dependencies",
        "contract_admin",
        "issuer"
      ],
      "properties": {
        "stability": {
          "type": "object",
          "required": [
            "fields"
          ],
          "properties": {
            "fields": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/field"
              }
            }
          },
          "additionalProperties": true
        },
        "backing": {
          "type": "object",
          "required": [
            "fields"
          ],
          "properties": {
            "fields": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/field"
              }
            }
          },
          "additionalProperties": true
        },
        "liquidity_exit": {
          "type": "object",
          "required": [
            "fields"
          ],
          "properties": {
            "fields": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/field"
              }
            }
          },
          "additionalProperties": true
        },
        "dependencies": {
          "type": "object",
          "required": [
            "fields"
          ],
          "properties": {
            "fields": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/field"
              }
            }
          },
          "additionalProperties": true
        },
        "contract_admin": {
          "type": "object",
          "required": [
            "fields"
          ],
          "properties": {
            "fields": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/field"
              }
            }
          },
          "additionalProperties": true
        },
        "issuer": {
          "type": "object",
          "required": [
            "fields"
          ],
          "properties": {
            "fields": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/field"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "local_candidate_not_authorized"
        }
      }
    },
    "cadence": {
      "type": "object",
      "required": [
        "selected",
        "scope",
        "exposure_classification",
        "exposure_as_of",
        "schedule_installed"
      ]
    },
    "coverage": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "field": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "owner",
        "source_refs",
        "clock",
        "basis",
        "status"
      ],
      "properties": {
        "value": {},
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "clock": {
          "type": "object"
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "source_record_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "pointer"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "pointer": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
